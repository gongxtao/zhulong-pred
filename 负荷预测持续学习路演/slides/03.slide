<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', display: 'flex', flexDirection: 'column', padding: '22px 64px 16px 64px' }}>
    <Box>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0A1D37' }}>我们卖的不是模型，而是让 Agent 可靠工作的 Harness</Text>
        <Text style={{ fontSize: 16, color: '#64748B', marginTop: 6 }}>Harness 把数据、工具、约束和反馈组织起来——让通用 Agent 成为垂直智能体</Text>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 28, flex: 1, marginTop: 16, alignItems: 'stretch' }}>
        <Box style={{ width: 700, position: 'relative', height: 545 }}>
            {/* L1 交互层 */}
            <Box style={{ position: 'absolute', left: 0, top: 0, width: 700, height: 54, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 10, flexDirection: 'row', alignItems: 'center' }}>
                <Box style={{ width: 100, alignItems: 'center' }}>
                    <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#475569' }}>交互层</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'row', gap: 8, alignItems: 'center' }}>
                    <Box style={{ padding: '5px 12px', background: '#FFFFFF', border: '1px solid #CBD5E1', borderRadius: 6 }}>
                        <Text style={{ fontSize: 12, color: '#0F2039' }}>聊天入口（自然语言）</Text>
                    </Box>
                    <Box style={{ padding: '5px 12px', background: '#FFFFFF', border: '1px solid #CBD5E1', borderRadius: 6 }}>
                        <Text style={{ fontSize: 12, color: '#0F2039' }}>Cron 定时任务</Text>
                    </Box>
                    <Box style={{ padding: '5px 12px', background: '#FFFFFF', border: '1px solid #CBD5E1', borderRadius: 6 }}>
                        <Text style={{ fontSize: 12, color: '#0F2039' }}>EDM 日志沉淀</Text>
                    </Box>
                </Box>
            </Box>
            {/* 箭头 1 */}
            <Box style={{ position: 'absolute', left: 0, top: 55, width: 700, height: 16, flexDirection: 'row', justifyContent: 'center', alignItems: 'center', gap: 6 }}>
                <Text style={{ fontSize: 14, color: '#94A3B8' }}>↓</Text>
                <Text style={{ fontSize: 11, color: '#94A3B8' }}>自然语言 / 定时触发</Text>
            </Box>
            {/* L2 Agent 层 */}
            <Box style={{ position: 'absolute', left: 0, top: 72, width: 700, height: 60, background: '#22D3EE', borderRadius: 10, flexDirection: 'row', alignItems: 'center' }}>
                <Box style={{ width: 100, alignItems: 'center' }}>
                    <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#0A1D37' }}>Agent 层</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0A1D37' }}>垂直智能体 —— 决定何时学、怎么学</Text>
                    <Text style={{ fontSize: 11.5, color: '#0A1D37', opacity: 0.72, marginTop: 3 }}>读取数据上下文与 EDM 日志 · 在约束内自主判断是否更新、如何更新</Text>
                </Box>
            </Box>
            {/* 箭头 2 */}
            <Box style={{ position: 'absolute', left: 0, top: 133, width: 700, height: 16, flexDirection: 'row', justifyContent: 'center', alignItems: 'center', gap: 6 }}>
                <Text style={{ fontSize: 14, color: '#94A3B8' }}>↓</Text>
                <Text style={{ fontSize: 11, color: '#94A3B8' }}>调用训练 · 验证 · 部署 Skill</Text>
            </Box>
            {/* L3 Harness 能力层 */}
            <Box style={{ position: 'absolute', left: 0, top: 150, width: 700, height: 172, background: '#0A1D37', borderRadius: 12, padding: 14 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#F8FAFC' }}>Harness 能力层</Text>
                    <Text style={{ fontSize: 11.5, color: '#22D3EE', marginLeft: 'auto' }}>把持续学习变成标准化、可复用的工程能力</Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 8, marginTop: 12, alignItems: 'stretch' }}>
                    <Box style={{ flex: 1, background: 'rgba(34,211,238,0.08)', border: '1px solid rgba(34,211,238,0.35)', borderRadius: 8, padding: 10, flexDirection: 'column' }}>
                        <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#22D3EE' }}>① EDM 漂移检测</Text>
                        <Text style={{ fontSize: 10.5, color: '#CBD5E1', marginTop: 5 }}>监测数据分布变化</Text>
                        <Text style={{ fontSize: 10.5, color: '#CBD5E1', marginTop: 2 }}>结论沉淀为日志</Text>
                    </Box>
                    <Box style={{ flex: 1, background: 'rgba(34,211,238,0.08)', border: '1px solid rgba(34,211,238,0.35)', borderRadius: 8, padding: 10, flexDirection: 'column' }}>
                        <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#22D3EE' }}>② 训练 Skill</Text>
                        <Text style={{ fontSize: 10.5, color: '#CBD5E1', marginTop: 5 }}>标准化训练能力</Text>
                        <Text style={{ fontSize: 10.5, color: '#CBD5E1', marginTop: 2 }}>训练前读 EDM 日志</Text>
                    </Box>
                    <Box style={{ flex: 1, background: 'rgba(34,211,238,0.08)', border: '1px solid rgba(34,211,238,0.35)', borderRadius: 8, padding: 10, flexDirection: 'column' }}>
                        <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#22D3EE' }}>③ 时序验证</Text>
                        <Text style={{ fontSize: 10.5, color: '#CBD5E1', marginTop: 5 }}>统一时序口径评估</Text>
                        <Text style={{ fontSize: 10.5, color: '#CBD5E1', marginTop: 2 }}>杜绝未来信息泄漏</Text>
                    </Box>
                    <Box style={{ flex: 1, background: 'rgba(34,211,238,0.08)', border: '1px solid rgba(34,211,238,0.35)', borderRadius: 8, padding: 10, flexDirection: 'column' }}>
                        <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#22D3EE' }}>④ 版本化部署</Text>
                        <Text style={{ fontSize: 10.5, color: '#CBD5E1', marginTop: 5 }}>发布 active 模型</Text>
                        <Text style={{ fontSize: 10.5, color: '#CBD5E1', marginTop: 2 }}>可回滚 · 可审计</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 11, color: '#94A3B8', marginTop: 10 }}>四项能力全部版本化管理，对外输出唯一的 active 模型</Text>
            </Box>
            {/* 箭头 3 */}
            <Box style={{ position: 'absolute', left: 0, top: 323, width: 700, height: 16, flexDirection: 'row', justifyContent: 'center', alignItems: 'center', gap: 6 }}>
                <Text style={{ fontSize: 14, color: '#94A3B8' }}>↓</Text>
                <Text style={{ fontSize: 11, color: '#94A3B8' }}>只读已到达数据</Text>
            </Box>
            {/* L4 数据层 */}
            <Box style={{ position: 'absolute', left: 0, top: 340, width: 700, height: 70, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 10, flexDirection: 'row', alignItems: 'center' }}>
                <Box style={{ width: 100, alignItems: 'center' }}>
                    <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#475569' }}>数据层</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'row', gap: 6, alignItems: 'center' }}>
                    <Box style={{ padding: '5px 10px', background: '#FFFFFF', border: '1px solid #CBD5E1', borderRadius: 6 }}>
                        <Text style={{ fontSize: 11.5, color: '#0F2039' }}>新增负荷</Text>
                    </Box>
                    <Box style={{ padding: '5px 10px', background: '#FFFFFF', border: '1px solid #CBD5E1', borderRadius: 6 }}>
                        <Text style={{ fontSize: 11.5, color: '#0F2039' }}>天气</Text>
                    </Box>
                    <Box style={{ padding: '5px 10px', background: '#FFFFFF', border: '1px solid #CBD5E1', borderRadius: 6 }}>
                        <Text style={{ fontSize: 11.5, color: '#0F2039' }}>历史分布</Text>
                    </Box>
                    <Box style={{ padding: '5px 10px', background: '#FFFFFF', border: '1px solid #CBD5E1', borderRadius: 6 }}>
                        <Text style={{ fontSize: 11.5, color: '#0F2039' }}>模型表现</Text>
                    </Box>
                    <Box style={{ padding: '5px 10px', background: '#FFFFFF', border: '1px solid #CBD5E1', borderRadius: 6 }}>
                        <Text style={{ fontSize: 11.5, color: '#0F2039' }}>EDM 日志</Text>
                    </Box>
                </Box>
            </Box>
            {/* 约束边界 */}
            <Box style={{ position: 'absolute', left: 0, top: 418, width: 700, height: 42, background: '#FFFBEB', border: '1px solid #F59E0B', borderRadius: 10, flexDirection: 'row', alignItems: 'center', padding: '0 16px', gap: 10 }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#B45309' }}>约束边界</Text>
                <Text style={{ fontSize: 12, color: '#92400E' }}>只能使用已到达数据 · 版本化管理 · 全程日志可审计 —— 产业客户需要的『可审计的自主权』</Text>
            </Box>
            {/* 底部注解 */}
            <Text style={{ position: 'absolute', left: 0, top: 470, width: 700, fontSize: 12, color: '#64748B', textAlign: 'center' }}>调用链自上而下：入口触发 → Agent 决策 → Harness 执行；数据层与约束边界全程兜底</Text>
            <Box style={{ position: 'absolute', left: 0, top: 494, width: 700, flexDirection: 'row', justifyContent: 'center', gap: 8 }}>
                <Box style={{ padding: '3px 10px', background: '#F1F5F9', borderRadius: 6 }}>
                    <Text style={{ fontSize: 11.5, color: '#64748B' }}>数据</Text>
                </Box>
                <Box style={{ padding: '3px 10px', background: '#F1F5F9', borderRadius: 6 }}>
                    <Text style={{ fontSize: 11.5, color: '#64748B' }}>工具</Text>
                </Box>
                <Box style={{ padding: '3px 10px', background: '#F1F5F9', borderRadius: 6 }}>
                    <Text style={{ fontSize: 11.5, color: '#64748B' }}>约束</Text>
                </Box>
                <Box style={{ padding: '3px 10px', background: '#F1F5F9', borderRadius: 6 }}>
                    <Text style={{ fontSize: 11.5, color: '#64748B' }}>反馈</Text>
                </Box>
                <Text style={{ fontSize: 11.5, color: '#94A3B8', alignSelf: 'center' }}>—— Harness 四要素贯穿全层</Text>
            </Box>
        </Box>

        <Box style={{ flex: 1, display: 'flex', flexDirection: 'column' }}>
            <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#0A1D37' }}>一句话定义</Text>
            <Box style={{ borderLeft: '4px solid #22D3EE', background: 'rgba(34,211,238,0.07)', borderRadius: '0 10px 10px 0', padding: 14, marginTop: 10 }}>
                <Text style={{ fontSize: 15, color: '#0F2039', lineHeight: 1.8 }}>Harness 把数据、工具、约束和反馈组织起来，让通用 Agent 成为负荷预测持续学习的垂直智能体。</Text>
            </Box>
            <Box style={{ marginTop: 16 }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0A1D37' }}>Agent 读取</Text>
                <Text style={{ fontSize: 13, color: '#64748B', marginTop: 4, lineHeight: 1.7 }}>新增负荷、天气、历史分布、模型表现、EDM 日志</Text>
                <Text style={{ fontSize: 12, color: '#94A3B8', marginTop: 4 }}>→ 自主判断是否学习、如何学习</Text>
            </Box>
            <Box style={{ marginTop: 12, paddingBottom: 12, borderBottom: '1px solid #E2E8F0' }}>
                <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0A1D37' }}>Harness 提供</Text>
                <Text style={{ fontSize: 13, color: '#64748B', marginTop: 4, lineHeight: 1.7 }}>EDM、训练、验证与部署能力，并限制其只能使用已到达数据</Text>
                <Text style={{ fontSize: 12, color: '#94A3B8', marginTop: 4 }}>→ 能力标准化，不依赖特定算法团队</Text>
            </Box>
            <Box style={{ borderLeft: '4px solid #0A1D37', background: '#F8FAFC', borderRadius: '0 10px 10px 0', padding: 14, marginTop: 16 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0A1D37' }}>约束是卖点</Text>
                <Text style={{ fontSize: 13, color: '#0F2039', lineHeight: 1.8, marginTop: 6 }}>Agent 可自主决定如何学习，但只能在 Harness 划定的数据边界与验证口径内行动——这正是产业客户需要的『可审计的自主权』。</Text>
            </Box>
            <Box style={{ borderLeft: '4px solid #F59E0B', background: '#FFFBEB', borderRadius: '0 10px 10px 0', padding: 14, marginTop: 12 }}>
                <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0A1D37' }}>为什么是工程问题</Text>
                <Text style={{ fontSize: 13, color: '#0F2039', lineHeight: 1.8, marginTop: 6 }}>模型会不会过时，不再取决于算法团队是否在场——持续学习成为标准化、可复用、可审计的工程能力。</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', marginTop: 12, alignItems: 'center' }}>
        <Text style={{ fontSize: 12, color: '#94A3B8' }}>负荷预测持续学习引擎 · 方案定义</Text>
        <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 10, height: 10, background: '#22D3EE' }} />
            <Text style={{ fontSize: 13, color: '#64748B' }}>CLE · 03 / 07</Text>
        </Box>
    </Box>
</Slide>
