<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', display: 'flex', flexDirection: 'column', padding: '20px 64px 14px 64px' }}>
    <Box>
        <Text style={{ fontSize: 31, fontWeight: 'bold', color: '#0A1D37' }}>Agent 决定如何学习，模型每天稳定地推理</Text>
        <Text style={{ fontSize: 16, color: '#64748B', marginTop: 5 }}>不是每天盲目重训——Agent 在约束下决定『是否更新、如何更新』</Text>
    </Box>

    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', marginTop: 14, gap: 8 }}>
        <Box style={{ background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 12, padding: '14px 20px' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Box style={{ borderLeft: '4px solid #22D3EE', paddingLeft: 10, flex: 1 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0A1D37' }}>持续学习闭环 · 事件驱动</Text>
                </Box>
                <Box style={{ padding: '3px 10px', border: '1px solid #22D3EE', borderRadius: 999 }}>
                    <Text style={{ fontSize: 11.5, color: '#0891B2' }}>新增数据 / 漂移信号触发</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 12, justifyContent: 'space-between' }}>
                <Box style={{ width: 190, height: 88, background: '#FFFFFF', border: '1.5px solid #E2E8F0', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F2039' }}>① 新增数据 / EDM 日志</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 6 }}>触发学习信号</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#94A3B8' }}>→</Text>
                <Box style={{ width: 190, height: 88, background: '#FFFFFF', border: '1.5px solid #E2E8F0', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F2039' }}>② Agent 判断变化</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 6 }}>读取既有 EDM 日志</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#94A3B8' }}>→</Text>
                <Box style={{ width: 190, height: 88, background: '#FFFFFF', border: '1.5px solid #E2E8F0', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F2039' }}>③ 调用训练 Skill</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 6 }}>必要时才重训</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#94A3B8' }}>→</Text>
                <Box style={{ width: 190, height: 88, background: '#FFFFFF', border: '1.5px solid #E2E8F0', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F2039' }}>④ 时序验证</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 6 }}>统一口径评估</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#94A3B8' }}>→</Text>
                <Box style={{ width: 190, height: 88, background: '#FFFFFF', border: '1.5px solid #22D3EE', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F2039' }}>⑤ 发布 active 模型</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 6 }}>版本可回滚</Text>
                </Box>
            </Box>
            <Box style={{ position: 'relative', width: '100%', height: 32, marginTop: 6 }}>
                <Box style={{ position: 'absolute', left: 85, top: 2, width: 865, height: 16, borderLeft: '1.5px solid #94A3B8', borderBottom: '1.5px solid #94A3B8', borderRight: '1.5px solid #94A3B8' }} />
                <Text style={{ position: 'absolute', left: 78, top: -8, fontSize: 12, color: '#94A3B8' }}>▲</Text>
                <Text style={{ position: 'absolute', left: 0, top: 22, width: '100%', fontSize: 11, color: '#94A3B8', textAlign: 'center' }}>模型表现与 EDM 日志回流为上下文 · 反馈</Text>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'column', alignItems: 'center', gap: 4 }}>
            <Text style={{ fontSize: 18, color: '#94A3B8' }}>↓</Text>
            <Box style={{ background: '#22D3EE', borderRadius: 8, padding: '9px 24px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 16.5, fontWeight: 'bold', color: '#0A1D37' }}>active 模型版本</Text>
                <Text style={{ fontSize: 12, color: '#0A1D37', opacity: 0.75 }}>生产环境的唯一模型入口</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 10, marginTop: 2 }}>
                <Box style={{ padding: '2px 10px', border: '1px solid #E2E8F0', borderRadius: 999 }}>
                    <Text style={{ fontSize: 11.5, color: '#64748B' }}>版本化管理</Text>
                </Box>
                <Box style={{ padding: '2px 10px', border: '1px solid #E2E8F0', borderRadius: 999 }}>
                    <Text style={{ fontSize: 11.5, color: '#64748B' }}>可回滚</Text>
                </Box>
                <Box style={{ padding: '2px 10px', border: '1px solid #E2E8F0', borderRadius: 999 }}>
                    <Text style={{ fontSize: 11.5, color: '#64748B' }}>学习闭环维护版本</Text>
                </Box>
            </Box>
            <Text style={{ fontSize: 18, color: '#94A3B8' }}>↓</Text>
        </Box>

        <Box style={{ background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 12, padding: '12px 20px' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Box style={{ borderLeft: '4px solid #0A1D37', paddingLeft: 10, flex: 1 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0A1D37' }}>生产推理闭环 · 每日一次</Text>
                </Box>
                <Box style={{ padding: '3px 10px', border: '1px solid #CBD5E1', borderRadius: 999 }}>
                    <Text style={{ fontSize: 11.5, color: '#64748B' }}>00:00 自动执行 · 无需人工</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', marginTop: 10, justifyContent: 'space-between' }}>
                <Box style={{ width: 320, height: 66, background: '#FFFFFF', border: '1.5px solid #E2E8F0', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F2039' }}>① 每日定时触发</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 4 }}>00:00 自动执行，无需人工</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#94A3B8' }}>→</Text>
                <Box style={{ width: 320, height: 66, background: '#FFFFFF', border: '1.5px solid #E2E8F0', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F2039' }}>② 自动加载当前 active 模型</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 4 }}>版本由学习闭环维护</Text>
                </Box>
                <Text style={{ fontSize: 20, color: '#94A3B8' }}>→</Text>
                <Box style={{ width: 320, height: 66, background: '#FFFFFF', border: '1.5px solid #E2E8F0', borderRadius: 8, padding: 12, justifyContent: 'center' }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0F2039' }}>③ 输出未来 24 小时预测</Text>
                    <Text style={{ fontSize: 12, color: '#64748B', marginTop: 4 }}>供峰值风险研判与重过载应对</Text>
                </Box>
            </Box>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 12 }}>
            <Box style={{ flex: 1, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 8, padding: '10px 16px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#64748B' }}>传统模式</Text>
                <Text style={{ fontSize: 13, color: '#94A3B8' }}>预测偏移 → 立项 / 采购 / 运维 → 1–2 个月后才更新</Text>
            </Box>
            <Box style={{ flex: 1, background: 'rgba(34,211,238,0.07)', border: '1px solid #22D3EE', borderRadius: 8, padding: '10px 16px', flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#0891B2' }}>持续学习</Text>
                <Text style={{ fontSize: 13, color: '#0F2039' }}>信号触发 → Agent 决策 → 验证发布 → 当日内完成</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', marginTop: 10, alignItems: 'center' }}>
        <Text style={{ fontSize: 12, color: '#94A3B8' }}>负荷预测持续学习引擎 · 双闭环架构</Text>
        <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ width: 10, height: 10, background: '#22D3EE' }} />
            <Text style={{ fontSize: 13, color: '#64748B' }}>CLE · 04 / 07</Text>
        </Box>
    </Box>
</Slide>
