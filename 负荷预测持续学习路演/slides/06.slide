                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 8 }}>
                    <Text style={{ width: 76, fontSize: 12.5, color: '#F8FAFC' }}>持续学习</Text>
                    <Box style={{ width: 400, height: 20, background: '#0A1D37', borderRadius: 4, position: 'relative' }}>
                        <Box style={{ position: 'absolute', left: 0, top: 0, width: 343, height: 20, background: '#22D3EE', borderRadius: 4 }} />
                    </Box>
                    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#22D3EE', marginLeft: 6 }}>342.99</Text>
                </Box>
            </Box>

            <Box style={{ height: 1, background: '#0A1D37', margin: '14px 0' }} />

            <Box style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 6 }}>
                <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#F8FAFC' }}>月度 WAPE 走势</Text>
                <Text style={{ marginLeft: 12, fontSize: 11.5, color: '#94A3B8' }}>2016-01 → 2018-08 · 动态模型长期低于静态</Text>
