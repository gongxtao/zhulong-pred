<Slide style={{ width: 1280, height: 720, background: '#0A1D37', display: 'flex', flexDirection: 'column', padding: '44px 64px 16px 64px' }}>
    <Text style={{ fontSize: 14, color: '#22D3EE', letterSpacing: 3 }}>实证 · 相同数据 · 相同模型</Text>
    <Text style={{ fontSize: 33, fontWeight: 'bold', color: '#F8FAFC', marginTop: 8 }}>相同数据、相同模型下，持续学习验证指标改善约 5.6%</Text>

    <Box style={{ flexDirection: 'row', gap: 40, flex: 1, marginTop: 20, alignItems: 'stretch' }}>
        <Box style={{ width: 400, display: 'flex', flexDirection: 'column' }}>
            <Text style={{ fontSize: 104, fontWeight: 'bold', color: '#22D3EE', fontFamily: 'Space Grotesk, Inter, sans-serif', lineHeight: 1.0 }}>5.6%</Text>
            <Text style={{ fontSize: 17, color: '#F8FAFC', marginTop: 8 }}>WAPE 相对改善</Text>
            <Box style={{ height: 1, background: '#123B63', margin: '20px 0' }} />
            <Box style={{ flexDirection: 'row', gap: 32 }}>
                <Box>
                    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#F8FAFC', fontFamily: 'Space Grotesk, Inter, sans-serif' }}>31 / 32</Text>
                    <Text style={{ fontSize: 12, color: '#94A3B8', marginTop: 4 }}>个月动态模型更优</Text>
                </Box>
                <Box>
                    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#F8FAFC', fontFamily: 'Space Grotesk, Inter, sans-serif' }}>68,040</Text>
                    <Text style={{ fontSize: 12, color: '#94A3B8', marginTop: 4 }}>共有预测主键 · 同口径对齐</Text>
                </Box>
            </Box>
            <Box style={{ marginTop: 18, border: '1px solid #123B63', borderRadius: 8, padding: '10px 14px' }}>
                <Text style={{ fontSize: 12, color: '#94A3B8', lineHeight: 1.7 }}>唯一回退月份：2016-07（WAPE +0.02 pp）——32 个月中仅 1 次略差，仍纳入统计、不做剔除。</Text>
            </Box>
            <Text style={{ fontSize: 13, color: '#94A3B8', lineHeight: 1.8, marginTop: 'auto' }}>改善不靠更换模型——在相同模型条件下，由持续学习获得。</Text>
        </Box>

        <Box style={{ flex: 1, background: '#123B63', borderRadius: 14, padding: 22, display: 'flex', flexDirection: 'column' }}>
            <Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#F8FAFC' }}>WAPE｜越低越好</Text>
                    <Box style={{ marginLeft: 'auto', border: '1px solid #22D3EE', borderRadius: 999, padding: '2px 10px' }}>
                        <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#22D3EE' }}>−0.2176 pp</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 10 }}>
                    <Text style={{ width: 76, fontSize: 12.5, color: '#94A3B8' }}>静态模型</Text>
                    <Box style={{ width: 400, height: 20, background: '#0A1D37', borderRadius: 4, position: 'relative' }}>
                        <Box style={{ position: 'absolute', left: 0, top: 0, width: 390, height: 20, background: '#94A3B8', borderRadius: 4 }} />
                    </Box>
                    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#F8FAFC', marginLeft: 6 }}>3.8876%</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 8 }}>
                    <Text style={{ width: 76, fontSize: 12.5, color: '#F8FAFC' }}>持续学习</Text>
                    <Box style={{ width: 400, height: 20, background: '#0A1D37', borderRadius: 4, position: 'relative' }}>
                        <Box style={{ position: 'absolute', left: 0, top: 0, width: 368, height: 20, background: '#22D3EE', borderRadius: 4 }} />
                    </Box>
                    <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#22D3EE', marginLeft: 6 }}>3.6700%</Text>
                </Box>
            </Box>

            <Box style={{ height: 1, background: '#0A1D37', margin: '14px 0' }} />

            <Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                    <Text style={{ fontSize: 14.5, fontWeight: 'bold', color: '#F8FAFC' }}>MAE｜越低越好</Text>
                    <Box style={{ marginLeft: 'auto', border: '1px solid #22D3EE', borderRadius: 999, padding: '2px 10px' }}>
                        <Text style={{ fontSize: 12.5, fontWeight: 'bold', color: '#22D3EE' }}>−20.34 MW</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 10 }}>
