                    <Box style={{ width: 400, height: 20, background: '#0A1D37', borderRadius: 4, position: 'relative' }}>
                        <Box style={{ position: 'absolute', left: 0, top: 0, width: 363, height: 20, background: '#94A3B8', borderRadius: 4 }} />
