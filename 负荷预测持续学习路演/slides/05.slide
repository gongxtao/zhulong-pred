                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 14 }}>
                    <Box style={{ width: 6, height: 6, background: '#22D3EE', borderRadius: 3 }} />
                    <Box>
                        <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#F8FAFC' }}>可用 —— 自然语言驱动学习</Text>
                        <Text style={{ fontSize: 11.5, color: '#94A3B8', marginTop: 2 }}>业务人员零门槛发起分析</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 12 }}>
                    <Box style={{ width: 6, height: 6, background: '#22D3EE', borderRadius: 3 }} />
                    <Box>
                        <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#F8FAFC' }}>可查 —— 结论沉淀为日志</Text>
                        <Text style={{ fontSize: 11.5, color: '#94A3B8', marginTop: 2 }}>漂移结论与训练依据随时回看</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 12 }}>
                    <Box style={{ width: 6, height: 6, background: '#22D3EE', borderRadius: 3 }} />
                    <Box>
                        <Text style={{ fontSize: 13.5, fontWeight: 'bold', color: '#F8FAFC' }}>可审计 —— 行为可追溯</Text>
                        <Text style={{ fontSize: 11.5, color: '#94A3B8', marginTop: 2 }}>所有动作约束在 Harness 边界内</Text>
                    </Box>
                </Box>
