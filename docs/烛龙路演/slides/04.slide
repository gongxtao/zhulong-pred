<Slide style={{ width: '1280px', height: '720px', background: '#0B1730', padding: '20px 60px 16px 60px', fontFamily: "'PingFang SC','Noto Sans SC',sans-serif", display: 'flex', flexDirection: 'column' }}>

  {/* A · 标题块 */}
  <Box style={{ height: 92, marginBottom: 12, flexShrink: 0 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E9F0FB', lineHeight: 1.3 }}>Agent 决定如何学习，模型每天稳定地推理</Text>
    <Box style={{ width: 44, height: 3, background: '#0891B2', marginTop: 6, marginBottom: 8, borderRadius: 2 }} />
    <Text style={{ fontSize: 16, color: 'rgba(233,240,251,0.62)' }}>两条运行路径，共用一个 active 模型版本——学习是决策，推理是流水线</Text>
  </Box>

  {/* B · 内容区 */}
  <Box style={{ height: 540, marginBottom: 10, flexShrink: 0, flexDirection: 'column', gap: 12 }}>

    <svg width={1160} height={430} viewBox="0 0 1160 430" fontFamily="'PingFang SC',sans-serif">
      {/* 上泳道标签 */}
      <rect x="0" y="0" width="230" height="32" rx="8" fill="rgba(8,145,178,0.12)" stroke="rgba(8,145,178,0.5)" strokeWidth="1" />
      <text x="16" y="21" fontSize="14" fontWeight="bold" fill="#0891B2">持续学习路径 · Agent 决策</text>

      {/* 五节点 */}
      <rect x="37" y="56" width="190" height="96" rx="10" fill="rgba(233,240,251,0.05)" stroke="rgba(233,240,251,0.20)" strokeWidth="1" />
      <text x="132" y="94" fontSize="17" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">新增数据 / EDM 日志</text>
      <text x="132" y="122" fontSize="12.5" fill="rgba(233,240,251,0.55)" textAnchor="middle">触发信号</text>

      <rect x="259" y="56" width="190" height="96" rx="10" fill="rgba(8,145,178,0.10)" stroke="rgba(8,145,178,0.6)" strokeWidth="1.5" />
      <text x="354" y="94" fontSize="17" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">Agent 判断变化</text>
      <text x="354" y="122" fontSize="12.5" fill="rgba(233,240,251,0.55)" textAnchor="middle">是否更新 · 如何更新</text>

      <rect x="481" y="56" width="190" height="96" rx="10" fill="rgba(233,240,251,0.05)" stroke="rgba(233,240,251,0.20)" strokeWidth="1" />
      <text x="576" y="94" fontSize="17" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">调用训练 Skill</text>
      <text x="576" y="122" fontSize="12.5" fill="rgba(233,240,251,0.55)" textAnchor="middle">按需，不盲目</text>

      <rect x="703" y="56" width="190" height="96" rx="10" fill="rgba(233,240,251,0.05)" stroke="rgba(233,240,251,0.20)" strokeWidth="1" />
      <text x="798" y="94" fontSize="17" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">时序验证</text>
      <text x="798" y="122" fontSize="12.5" fill="rgba(233,240,251,0.55)" textAnchor="middle">统一口径</text>

      <rect x="925" y="56" width="190" height="96" rx="10" fill="rgba(194,98,10,0.14)" stroke="rgba(194,98,10,0.65)" strokeWidth="1.5" />
      <text x="1020" y="94" fontSize="17" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">发布 active 模型</text>
      <text x="1020" y="122" fontSize="12.5" fill="rgba(233,240,251,0.55)" textAnchor="middle">新版本生效</text>

      {/* 节点间箭头 */}
      <g stroke="#0891B2" strokeWidth="2">
        <line x1="227" y1="104" x2="251" y2="104" />
        <line x1="449" y1="104" x2="473" y2="104" />
        <line x1="671" y1="104" x2="695" y2="104" />
        <line x1="893" y1="104" x2="917" y2="104" />
      </g>
      <g fill="#0891B2">
        <path d="M 259 104 L 249 99 L 249 109 Z" />
        <path d="M 481 104 L 471 99 L 471 109 Z" />
        <path d="M 703 104 L 693 99 L 693 109 Z" />
        <path d="M 925 104 L 915 99 L 915 109 Z" />
      </g>

      {/* 闭环回流 */}
      <path d="M 1020 54 C 1020 16, 354 16, 354 48" stroke="rgba(8,145,178,0.55)" strokeWidth="1.5" strokeDasharray="6 5" fill="none" />
      <path d="M 354 56 L 349 45 L 359 45 Z" fill="rgba(8,145,178,0.55)" />
      <text x="687" y="44" fontSize="13" fill="rgba(233,240,251,0.55)" textAnchor="middle">持续闭环 · 新表现回流为下一轮判断上下文</text>

      {/* active 版本连接 */}
      <line x1="1020" y1="152" x2="1020" y2="196" stroke="rgba(194,98,10,0.6)" strokeWidth="1.5" strokeDasharray="5 4" />
      <rect x="880" y="200" width="280" height="56" rx="10" fill="rgba(194,98,10,0.12)" stroke="#C2620A" strokeWidth="1.5" />
      <text x="902" y="235" fontSize="18" fontWeight="bold" fill="#C2620A" fontFamily="'Menlo',monospace">● active v07</text>
      <text x="1136" y="234" fontSize="12" fill="rgba(233,240,251,0.55)" textAnchor="end">当前生产版本</text>
      <line x1="1020" y1="256" x2="1020" y2="292" stroke="rgba(194,98,10,0.6)" strokeWidth="1.5" strokeDasharray="5 4" />
      <path d="M 1020 298 L 1015 288 L 1025 288 Z" fill="rgba(194,98,10,0.7)" />

      {/* 下泳道标签 */}
      <rect x="0" y="316" width="200" height="32" rx="8" fill="rgba(233,240,251,0.05)" stroke="rgba(233,240,251,0.20)" strokeWidth="1" />
      <text x="16" y="337" fontSize="14" fontWeight="bold" fill="rgba(233,240,251,0.75)">生产推理路径 · 流水线</text>

      <rect x="240" y="296" width="240" height="96" rx="10" fill="rgba(233,240,251,0.05)" stroke="rgba(233,240,251,0.20)" strokeWidth="1" />
      <text x="360" y="334" fontSize="17" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">每日 00:00 · Cron</text>
      <text x="360" y="362" fontSize="12.5" fill="rgba(233,240,251,0.55)" textAnchor="middle">自动触发，无人工介入</text>

      <rect x="520" y="296" width="240" height="96" rx="10" fill="rgba(8,145,178,0.10)" stroke="rgba(8,145,178,0.6)" strokeWidth="1.5" />
      <text x="640" y="334" fontSize="17" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">加载 active 模型</text>
      <text x="640" y="362" fontSize="12.5" fill="rgba(233,240,251,0.55)" textAnchor="middle">永远是上线的版本</text>

      <rect x="800" y="296" width="240" height="96" rx="10" fill="rgba(233,240,251,0.05)" stroke="rgba(233,240,251,0.20)" strokeWidth="1" />
      <text x="920" y="334" fontSize="17" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">输出未来 24h 预测</text>
      <text x="920" y="362" fontSize="12.5" fill="rgba(233,240,251,0.55)" textAnchor="middle">稳定流水线，每天一次</text>

      <g stroke="#0891B2" strokeWidth="2">
        <line x1="480" y1="344" x2="512" y2="344" />
        <line x1="760" y1="344" x2="792" y2="344" />
      </g>
      <g fill="#0891B2">
        <path d="M 520 344 L 510 339 L 510 349 Z" />
        <path d="M 800 344 L 790 339 L 790 349 Z" />
      </g>
    </svg>

    {/* 洞察条 */}
    <Box style={{ height: 98, background: 'rgba(233,240,251,0.05)', border: '1px solid rgba(233,240,251,0.14)', borderLeft: '3px solid #0891B2', borderRadius: 10, padding: '16px 20px', flexDirection: 'row', alignItems: 'center', gap: 24 }}>
      <Text style={{ flex: 1, fontSize: 17, color: 'rgba(233,240,251,0.85)', lineHeight: 1.6 }}>不是每天盲目重训——「是否更新、如何更新」由 Agent 在约束下决定；<br />生产侧每天只做一件事：加载 active 模型，输出未来 24 小时预测。</Text>
      <Box style={{ padding: '10px 16px', borderRadius: 8, background: 'rgba(194,98,10,0.12)', border: '1px solid rgba(194,98,10,0.5)', flexShrink: 0 }}>
        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#C2620A', fontFamily: "'Menlo','Courier New',monospace" }}>active = 唯一生产入口</Text>
      </Box>
    </Box>
  </Box>

  {/* C · 页脚条 */}
  <Box style={{ height: 24, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', flexShrink: 0 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
      <Box style={{ width: 6, height: 6, background: '#0891B2' }} />
      <Text style={{ fontSize: 12, color: 'rgba(233,240,251,0.40)' }}>烛龙 ZHULONG</Text>
    </Box>
    <Text style={{ fontSize: 12, color: 'rgba(233,240,251,0.40)', fontFamily: "'Menlo','Courier New',monospace" }}>04 / 07</Text>
  </Box>
</Slide>
