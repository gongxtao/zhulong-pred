<Slide style={{ width: '1280px', height: '720px', background: '#0B1730', padding: '20px 60px 16px 60px', fontFamily: "'PingFang SC','Noto Sans SC',sans-serif", display: 'flex', flexDirection: 'column' }}>

  {/* A · 标题块 */}
  <Box style={{ height: 92, marginBottom: 12, flexShrink: 0 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E9F0FB', lineHeight: 1.3 }}>我们卖的不是模型，而是让 Agent 可靠工作的 Harness</Text>
    <Box style={{ width: 44, height: 3, background: '#0891B2', marginTop: 6, marginBottom: 8, borderRadius: 2 }} />
    <Text style={{ fontSize: 16, color: 'rgba(233,240,251,0.62)' }}>分工：Agent 负责判断，Harness 负责供给能力、守住约束</Text>
  </Box>

  {/* B · 内容区 */}
  <Box style={{ height: 540, marginBottom: 10, flexShrink: 0, flexDirection: 'row', gap: 24 }}>

    {/* 左 · 中心辐射架构图 */}
    <Box style={{ width: 700, flexShrink: 0 }}>
      <svg width={700} height={540} viewBox="0 0 700 540" fontFamily="'PingFang SC',sans-serif">
        {/* 组标签 */}
        <text x="20" y="116" fontSize="13" fontWeight="bold" fill="#0891B2" letterSpacing="2">读取</text>
        <text x="480" y="46" fontSize="13" fill="rgba(233,240,251,0.55)" letterSpacing="2">供给与约束</text>

        {/* 中心 Agent */}
        <circle cx="350" cy="240" r="88" fill="rgba(8,145,178,0.10)" />
        <circle cx="350" cy="240" r="60" fill="rgba(8,145,178,0.16)" stroke="#0891B2" strokeWidth="1.5" />
        <text x="350" y="236" fontSize="26" fontWeight="bold" fill="#E9F0FB" textAnchor="middle" fontFamily="'Menlo',monospace">Agent</text>
        <text x="350" y="262" fontSize="13" fill="rgba(233,240,251,0.60)" textAnchor="middle">负责判断</text>

        {/* 左节点 · 数据上下文 */}
        <rect x="20" y="130" width="230" height="230" rx="12" fill="rgba(233,240,251,0.05)" stroke="rgba(8,145,178,0.45)" strokeWidth="1" />
        <text x="40" y="164" fontSize="15" fontWeight="bold" fill="#0891B2">数据上下文 · Agent 读取</text>
        <g fill="#0891B2">
          <circle cx="48" cy="196" r="2.5" /><circle cx="48" cy="226" r="2.5" /><circle cx="48" cy="256" r="2.5" /><circle cx="48" cy="286" r="2.5" /><circle cx="48" cy="316" r="2.5" />
        </g>
        <text x="60" y="201" fontSize="14" fill="rgba(233,240,251,0.80)">新增负荷</text>
        <text x="60" y="231" fontSize="14" fill="rgba(233,240,251,0.80)">天气</text>
        <text x="60" y="261" fontSize="14" fill="rgba(233,240,251,0.80)">历史分布</text>
        <text x="60" y="291" fontSize="14" fill="rgba(233,240,251,0.80)">模型表现</text>
        <text x="60" y="321" fontSize="14" fill="rgba(233,240,251,0.80)">EDM 日志</text>

        {/* 连线：左节点 → Agent */}
        <line x1="250" y1="245" x2="282" y2="245" stroke="rgba(8,145,178,0.7)" strokeWidth="2" />
        <path d="M 290 245 L 280 240 L 280 250 Z" fill="rgba(8,145,178,0.7)" />

        {/* 连线：Agent → 右侧三节点 */}
        <path d="M 412 220 C 446 200, 452 140, 476 116" stroke="rgba(8,145,178,0.55)" strokeWidth="1.8" fill="none" />
        <path d="M 480 112 L 469 113 L 475 122 Z" fill="rgba(8,145,178,0.55)" />
        <line x1="412" y1="242" x2="472" y2="242" stroke="rgba(8,145,178,0.55)" strokeWidth="1.8" />
        <path d="M 480 242 L 470 237 L 470 247 Z" fill="rgba(8,145,178,0.55)" />
        <path d="M 412 264 C 446 284, 452 344, 476 368" stroke="rgba(8,145,178,0.55)" strokeWidth="1.8" fill="none" />
        <path d="M 480 372 L 475 362 L 469 370 Z" fill="rgba(8,145,178,0.55)" />

        {/* 右上 · EDM */}
        <rect x="482" y="60" width="198" height="104" rx="10" fill="rgba(233,240,251,0.05)" stroke="rgba(233,240,251,0.20)" strokeWidth="1" />
        <text x="502" y="94" fontSize="15" fontWeight="bold" fill="#E9F0FB">EDM · 漂移诊断</text>
        <text x="502" y="120" fontSize="12.5" fill="rgba(233,240,251,0.55)">分析数据变化与成因</text>
        <text x="502" y="142" fontSize="12.5" fill="rgba(233,240,251,0.55)">结论沉淀为日志与上下文</text>

        {/* 右中 · 训练验证 */}
        <rect x="482" y="196" width="198" height="104" rx="10" fill="rgba(233,240,251,0.05)" stroke="rgba(233,240,251,0.20)" strokeWidth="1" />
        <text x="502" y="230" fontSize="15" fontWeight="bold" fill="#E9F0FB">训练 · 验证</text>
        <text x="502" y="256" fontSize="12.5" fill="rgba(233,240,251,0.55)">训练 Skill 按需调用</text>
        <text x="502" y="278" fontSize="12.5" fill="rgba(233,240,251,0.55)">统一时序验证口径</text>

        {/* 右下 · 发布约束（琥珀） */}
        <rect x="482" y="332" width="198" height="104" rx="10" fill="rgba(194,98,10,0.08)" stroke="rgba(194,98,10,0.55)" strokeWidth="1" />
        <text x="502" y="366" fontSize="15" fontWeight="bold" fill="#E9F0FB">部署 · 发布约束</text>
        <text x="502" y="392" fontSize="12.5" fill="rgba(233,240,251,0.55)">只使用已到达的数据</text>
        <text x="502" y="414" fontSize="12.5" fill="rgba(233,240,251,0.55)">验证通过才发布 active</text>

        {/* 反馈闭环 */}
        <path d="M 581 436 C 581 512, 135 524, 135 366" stroke="rgba(8,145,178,0.45)" strokeWidth="1.5" strokeDasharray="6 5" fill="none" />
        <path d="M 135 360 L 130 371 L 140 371 Z" fill="rgba(8,145,178,0.45)" />
        <text x="358" y="512" fontSize="13" fill="rgba(233,240,251,0.55)" textAnchor="middle">反馈：发布后的模型表现，回流为下一轮学习上下文</text>
      </svg>
    </Box>

    {/* 右 · 定义卡 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16 }}>
      <Box style={{ background: 'rgba(8,145,178,0.08)', border: '1px solid rgba(8,145,178,0.35)', borderRadius: 12, padding: 22 }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#0891B2', letterSpacing: 2 }}>一句话定义</Text>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#E9F0FB', lineHeight: 1.55, marginTop: 10 }}>Harness 把数据、工具、约束和反馈组织起来，让通用 Agent 成为负荷预测持续学习的垂直智能体。</Text>
      </Box>
      <Box style={{ background: 'rgba(233,240,251,0.05)', border: '1px solid rgba(233,240,251,0.14)', borderRadius: 12, padding: 22 }}>
        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#C2620A', letterSpacing: 2 }}>我们卖的</Text>
        <Text style={{ fontSize: 17, color: 'rgba(233,240,251,0.82)', lineHeight: 1.6, marginTop: 10 }}>不是一次性的更大模型，而是让模型持续变好的工程系统——交付之后，它依然在学习。</Text>
      </Box>
      <Box style={{ marginTop: 'auto' }}>
        <Text style={{ fontSize: 13, color: 'rgba(233,240,251,0.50)', marginBottom: 10 }}>HARNESS 三要素</Text>
        <Box style={{ flexDirection: 'row', gap: 12 }}>
          <Box style={{ flex: 1, background: 'rgba(233,240,251,0.05)', border: '1px solid rgba(233,240,251,0.14)', borderRadius: 10, padding: '14px 0', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E9F0FB' }}>数据</Text>
            <Text style={{ fontSize: 11, color: 'rgba(233,240,251,0.50)', marginTop: 4 }}>有上下文</Text>
          </Box>
          <Box style={{ flex: 1, background: 'rgba(233,240,251,0.05)', border: '1px solid rgba(233,240,251,0.14)', borderRadius: 10, padding: '14px 0', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E9F0FB' }}>工具 + 约束</Text>
            <Text style={{ fontSize: 11, color: 'rgba(233,240,251,0.50)', marginTop: 4 }}>能干且不越界</Text>
          </Box>
          <Box style={{ flex: 1, background: 'rgba(233,240,251,0.05)', border: '1px solid rgba(233,240,251,0.14)', borderRadius: 10, padding: '14px 0', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E9F0FB' }}>反馈</Text>
            <Text style={{ fontSize: 11, color: 'rgba(233,240,251,0.50)', marginTop: 4 }}>经验会积累</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>

  {/* C · 页脚条 */}
  <Box style={{ height: 24, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', flexShrink: 0 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
      <Box style={{ width: 6, height: 6, background: '#0891B2' }} />
      <Text style={{ fontSize: 12, color: 'rgba(233,240,251,0.40)' }}>烛龙 ZHULONG</Text>
    </Box>
    <Text style={{ fontSize: 12, color: 'rgba(233,240,251,0.40)', fontFamily: "'Menlo','Courier New',monospace" }}>03 / 07</Text>
  </Box>
</Slide>
