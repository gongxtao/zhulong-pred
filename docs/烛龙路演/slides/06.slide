<Slide style={{ width: '1280px', height: '720px', background: '#0B1730', padding: '20px 60px 16px 60px', fontFamily: "'PingFang SC','Noto Sans SC',sans-serif", display: 'flex', flexDirection: 'column' }}>

  {/* A · 标题块 */}
  <Box style={{ height: 92, marginBottom: 12, flexShrink: 0 }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E9F0FB', lineHeight: 1.3 }}>相同数据、相同模型，持续学习让误差再降 5.6%</Text>
    <Box style={{ width: 44, height: 3, background: '#0891B2', marginTop: 6, marginBottom: 8, borderRadius: 2 }} />
    <Text style={{ fontSize: 16, color: 'rgba(233,240,251,0.62)' }}>31 个月逐月对账 · 2016-01 至 2018-08 · 同一模型仅学习方式不同</Text>
  </Box>

  {/* B · 内容区 */}
  <Box style={{ height: 540, marginBottom: 10, flexShrink: 0, flexDirection: 'row', gap: 32 }}>

    {/* 左 · 巨型数字与对账 */}
    <Box style={{ width: 396, flexShrink: 0, flexDirection: 'column' }}>
      <Box style={{ position: 'relative', height: 190 }}>
        <Box style={{ position: 'absolute', width: 320, height: 320, top: -70, left: 10, background: 'radial-gradient(circle, rgba(194,98,10,0.20) 0%, rgba(194,98,10,0) 70%)' }} />
        <Text style={{ position: 'relative', fontSize: 100, fontWeight: 'bold', color: '#C2620A', fontFamily: "'Menlo','Courier New',monospace", lineHeight: 1.1 }}>−5.6%</Text>
        <Text style={{ position: 'relative', fontSize: 16, color: 'rgba(233,240,251,0.75)', marginTop: 6 }}>WAPE 相对改善（整体口径）</Text>
      </Box>

      <Box style={{ marginTop: 18, flexDirection: 'column' }}>
        <Box style={{ borderTop: '1px solid rgba(233,240,251,0.14)', paddingTop: 12, flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 13, color: 'rgba(233,240,251,0.50)' }}>WAPE（加权绝对百分比误差）</Text>
          <Text style={{ fontSize: 19, color: '#E9F0FB', fontFamily: "'Menlo','Courier New',monospace" }}>3.8876% <span style={{ color: '#C2620A' }}>→</span> <span style={{ color: '#0891B2', fontWeight: 'bold' }}>3.6700%</span> <span style={{ fontSize: 14, color: '#C2620A' }}>−0.2176 pp</span></Text>
        </Box>
        <Box style={{ borderTop: '1px solid rgba(233,240,251,0.14)', paddingTop: 12, marginTop: 12, flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 13, color: 'rgba(233,240,251,0.50)' }}>MAE（平均绝对误差）</Text>
          <Text style={{ fontSize: 19, color: '#E9F0FB', fontFamily: "'Menlo','Courier New',monospace" }}>363.33 <span style={{ color: '#C2620A' }}>→</span> <span style={{ color: '#0891B2', fontWeight: 'bold' }}>342.99</span> MW <span style={{ fontSize: 14, color: '#C2620A' }}>−20.34</span></Text>
        </Box>
        <Box style={{ borderTop: '1px solid rgba(233,240,251,0.14)', paddingTop: 12, marginTop: 12, flexDirection: 'column', gap: 4 }}>
          <Text style={{ fontSize: 13, color: 'rgba(233,240,251,0.50)' }}>逐月对账</Text>
          <Text style={{ fontSize: 17, color: '#E9F0FB' }}>31 个月 · <span style={{ color: '#0891B2', fontWeight: 'bold' }}>30 个月持续学习更优</span>（仅 1 个月略差）</Text>
        </Box>
      </Box>

      <Text style={{ marginTop: 'auto', fontSize: 12, color: 'rgba(233,240,251,0.40)', lineHeight: 1.5 }}>验证集结果，非生产承诺；月度明细见 monthly_static_dynamic_validation_metrics.csv（68,040 个共有预测主键，按纽约本地预测月份统计）</Text>
    </Box>

    {/* 右 · 双柱图组 */}
    <Box style={{ flex: 1, flexDirection: 'column' }}>
      <Box style={{ height: 24, flexDirection: 'row', alignItems: 'center', gap: 24 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <Box style={{ width: 12, height: 12, background: '#C2620A', borderRadius: 3 }} />
          <Text style={{ fontSize: 14, color: 'rgba(233,240,251,0.70)' }}>静态模型（初始）</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <Box style={{ width: 12, height: 12, background: '#0891B2', borderRadius: 3 }} />
          <Text style={{ fontSize: 14, color: 'rgba(233,240,251,0.70)' }}>持续学习模型</Text>
        </Box>
        <Text style={{ flex: 1, textAlign: 'right', fontSize: 12, color: 'rgba(233,240,251,0.45)' }}>不是换更大的模型，而是让同一个模型持续变好</Text>
      </Box>
      <Box style={{ flex: 1, marginTop: 10, flexDirection: 'row', gap: 20 }}>
        <Chart
          chartType='barChart'
          barDirection='bar'
          title='WAPE（%）'
          titleColor='#E9F0FB'
          showLegend={false}
          showDataLabels={true}
          dataLabelColor='#E9F0FB'
          axisColor='rgba(233,240,251,0.50)'
          colors={['#C2620A', '#0891B2']}
          background='#0B1730'
          style={{ flex: 1, height: 460 }}
          data={[
            ['', '静态模型', '持续学习'],
            ['整体', 3.8876, 3.67],
          ]}
        />
        <Chart
          chartType='barChart'
          barDirection='bar'
          title='MAE（MW）'
          titleColor='#E9F0FB'
          showLegend={false}
          showDataLabels={true}
          dataLabelColor='#E9F0FB'
          axisColor='rgba(233,240,251,0.50)'
          colors={['#C2620A', '#0891B2']}
          background='#0B1730'
          style={{ flex: 1, height: 460 }}
          data={[
            ['', '静态模型', '持续学习'],
            ['整体', 363.33, 342.99],
          ]}
        />
      </Box>
    </Box>
  </Box>

  {/* C · 页脚条 */}
  <Box style={{ height: 24, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', flexShrink: 0 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
      <Box style={{ width: 6, height: 6, background: '#0891B2' }} />
      <Text style={{ fontSize: 12, color: 'rgba(233,240,251,0.40)' }}>烛龙 ZHULONG</Text>
    </Box>
    <Text style={{ fontSize: 12, color: 'rgba(233,240,251,0.40)', fontFamily: "'Menlo','Courier New',monospace" }}>06 / 07</Text>
  </Box>
</Slide>
