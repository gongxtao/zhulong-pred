<Slide style={{ width: '1280px', height: '720px', background: '#0B1730', position: 'relative', fontFamily: "'PingFang SC','Noto Sans SC',sans-serif", padding: 0 }}>

  <svg width={1280} height={720} viewBox="0 0 1280 720" style={{ position: 'absolute', top: 0, left: 0 }}>
    {/* 夜航微光网格 */}
    <g stroke="rgba(233,240,251,0.05)" strokeWidth="1">
      <line x1="60" y1="80" x2="1220" y2="80" />
      <line x1="60" y1="170" x2="1220" y2="170" />
      <line x1="60" y1="350" x2="1220" y2="350" />
      <line x1="60" y1="440" x2="1220" y2="440" />
      <line x1="60" y1="530" x2="1220" y2="530" />
      <line x1="236" y1="60" x2="236" y2="545" />
      <line x1="412" y1="60" x2="412" y2="545" />
      <line x1="588" y1="60" x2="588" y2="545" />
      <line x1="764" y1="60" x2="764" y2="545" />
      <line x1="940" y1="60" x2="940" y2="545" />
      <line x1="1116" y1="60" x2="1116" y2="545" />
    </g>
    {/* 星点 */}
    <g fill="rgba(233,240,251,0.14)">
      <circle cx="180" cy="70" r="1.6" />
      <circle cx="520" cy="55" r="1.3" />
      <circle cx="700" cy="95" r="1.8" />
      <circle cx="1180" cy="60" r="1.4" />
      <circle cx="90" cy="120" r="1.4" />
    </g>
    {/* 实际负荷下方淡填充 */}
    <path d="M 60 470 C 120 500, 160 510, 220 505 C 300 498, 340 440, 420 400 C 500 360, 560 350, 640 330 C 700 315, 760 300, 820 268 C 850 252, 870 246, 880 244 C 900 248, 940 300, 1000 380 C 1060 450, 1120 480, 1220 500 L 1220 560 L 60 560 Z" fill="rgba(8,145,178,0.07)" />
    {/* 变压器重过载阈值 */}
    <line x1="60" y1="300" x2="1220" y2="300" stroke="rgba(233,240,251,0.35)" strokeWidth="1.5" strokeDasharray="10 6" />
    <text x="66" y="292" fontSize="14" fill="rgba(233,240,251,0.55)" fontFamily="'PingFang SC',sans-serif">变压器重过载阈值</text>
    {/* 预测低估的实际峰值区域 */}
    <path d="M 700 342 C 760 327, 820 295, 880 255 C 900 259, 940 311, 1000 391 L 1000 396 C 940 341, 900 305, 880 301 C 820 323, 760 331, 700 341 Z" fill="rgba(194,98,10,0.18)" />
    {/* 预测负荷（琥珀虚线，峰值被低估） */}
    <path d="M 60 470 C 120 500, 160 510, 220 505 C 300 498, 340 442, 420 402 C 500 364, 560 354, 640 340 C 700 330, 760 322, 820 310 C 850 306, 870 302, 880 300 C 900 304, 940 340, 1000 395 C 1060 455, 1120 482, 1220 500" fill="none" stroke="#C2620A" strokeWidth="2.5" strokeDasharray="12 8" />
    {/* 实际负荷（青实线，冲过阈值） */}
    <path d="M 60 470 C 120 500, 160 510, 220 505 C 300 498, 340 440, 420 400 C 500 360, 560 350, 640 330 C 700 315, 760 300, 820 268 C 850 252, 870 246, 880 244 C 900 248, 940 300, 1000 380 C 1060 450, 1120 480, 1220 500" fill="none" stroke="#0891B2" strokeWidth="3" />
    {/* 曲线标签 */}
    <text x="1010" y="360" fontSize="16" fontWeight="bold" fill="#0891B2" fontFamily="'PingFang SC',sans-serif">实际负荷</text>
    <text x="1010" y="432" fontSize="16" fontWeight="bold" fill="#C2620A" fontFamily="'PingFang SC',sans-serif">预测负荷</text>
    {/* 峰值标记 */}
    <circle cx="880" cy="244" r="12" fill="rgba(194,98,10,0.25)" />
    <path d="M 880 226 L 891 244 L 869 244 Z" fill="#C2620A" />
    <text x="898" y="238" fontSize="15" fontWeight="bold" fill="#E9F0FB" fontFamily="'PingFang SC',sans-serif">未预见的实际峰值</text>
    {/* 风险链连接线 */}
    <path d="M 950 148 L 890 220" stroke="rgba(194,98,10,0.5)" strokeWidth="1.5" strokeDasharray="4 4" fill="none" />
    {/* 风险链三节 */}
    <text x="690" y="90" fontSize="13" fill="rgba(233,240,251,0.55)" letterSpacing="3" fontFamily="'PingFang SC',sans-serif">风 险 链</text>
    <g fontFamily="'PingFang SC',sans-serif">
      <rect x="690" y="102" width="150" height="46" rx="8" fill="rgba(194,98,10,0.10)" stroke="rgba(194,98,10,0.55)" strokeWidth="1" />
      <text x="765" y="131" fontSize="16" fill="#E9F0FB" textAnchor="middle">未预见峰值</text>
      <path d="M 848 125 L 866 125 L 860 120 L 866 125 L 860 130 Z" fill="rgba(194,98,10,0.8)" />
      <rect x="872" y="102" width="150" height="46" rx="8" fill="rgba(194,98,10,0.16)" stroke="rgba(194,98,10,0.65)" strokeWidth="1" />
      <text x="947" y="131" fontSize="16" fill="#E9F0FB" textAnchor="middle">持续重过载</text>
      <path d="M 1030 125 L 1048 125 L 1042 120 L 1048 125 L 1042 130 Z" fill="rgba(194,98,10,0.8)" />
      <rect x="1054" y="102" width="140" height="46" rx="8" fill="rgba(194,98,10,0.30)" stroke="#C2620A" strokeWidth="1.5" />
      <text x="1124" y="131" fontSize="16" fontWeight="bold" fill="#E9F0FB" textAnchor="middle">设备损坏</text>
    </g>
  </svg>

  {/* 骑线主标题区 */}
  <Box style={{ position: 'absolute', left: 60, top: 540, width: 820 }}>
    <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#E9F0FB', lineHeight: 1.15, letterSpacing: 6 }}>烛龙 ZHULONG</Text>
    <Box style={{ width: 56, height: 4, background: '#0891B2', marginTop: 12, borderRadius: 2 }} />
    <Text style={{ fontSize: 22, color: 'rgba(233,240,251,0.80)', marginTop: 14 }}>面向电力负荷预测持续学习的智能引擎</Text>
