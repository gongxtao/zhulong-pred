<Slide style={{ width: '1280px', height: '720px', background: '#0B1730', padding: '48px 60px 40px 60px', fontFamily: "'PingFang SC','Noto Sans SC',sans-serif", display: 'flex', flexDirection: 'column', alignItems: 'center', position: 'relative' }}>

